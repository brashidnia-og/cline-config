{
  "mcpServers": {
    "local-playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "disabled": false,
      "autoApprove": []
    },
    "local-chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "disabled": false,
      "autoApprove": []
    },
    "local-precision-math": {
      "command": "npx",
      "args": ["-y", "@nerdo/precision-math-mcp"],
      "env": {
        "PATH": "${env:HOME}/.bun/bin:${env:PATH}"
      },
      "disabled": false,
      "autoApprove": []
    },
    "local-context7": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:3000/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CONTEXT7_API_KEY}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "local-searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "${env:SEARXNG_URL}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "external-brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "external-tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${env:TAVILY_API_KEY}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "external-context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "external-ref": {
      "command": "npx",
      "args": ["-y", "ref-tools-mcp@latest"],
      "env": {
        "REF_API_KEY": "${env:REF_API_KEY}"
      },
      "disabled": true,
      "autoApprove": []
    },
    "external-deepwiki": {
      "type": "streamableHttp",
      "url": "https://mcp.deepwiki.com/mcp",
      "disabled": true,
      "autoApprove": []
    }
  }
}
