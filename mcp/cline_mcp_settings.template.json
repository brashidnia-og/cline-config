{
  "mcpServers": {
    "local-playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "disabled": false,
      "autoApprove": []
    },
    "local-chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "disabled": false,
      "autoApprove": []
    },
    "local-precision-math": {
      "command": "npx",
      "args": ["-y", "@nerdo/precision-math-mcp"],
      "env": {
        "PATH": "__CLINE_CONFIG_BUN_PATH__"
      },
      "disabled": false,
      "autoApprove": []
    },
    "local-context7": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:3000/mcp",
      "disabled": true,
      "autoApprove": []
    },
    "local-searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "disabled": true,
      "autoApprove": []
    },
    "external-brave-search": {
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "disabled": true,
      "autoApprove": []
    },
    "external-tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "disabled": true,
      "autoApprove": []
    },
    "external-context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": true,
      "autoApprove": []
    },
    "external-ref": {
      "command": "npx",
      "args": ["-y", "ref-tools-mcp@latest"],
      "disabled": true,
      "autoApprove": []
    },
    "external-deepwiki": {
      "type": "streamableHttp",
      "url": "https://mcp.deepwiki.com/mcp",
      "disabled": true,
      "autoApprove": []
    }
  }
}
